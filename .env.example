# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional per-turn spending cap in USD.
PHRAX_MAX_BUDGET_USD=

# Slack (HTTP Events API)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
PORT=3000
# Optional. Static ngrok domain used by `make start`, e.g. phrax.ngrok-free.app.
# Without it, ngrok picks a new random URL on every start.
NGROK_URL=

# GitHub fine-grained personal access token
GITHUB_TOKEN=
# Named repositories: any <NAME>_REPOSITORY=owner/repository. Phrax picks the
# right one (or several) for each request; users can also say the name.
BACKEND_REPOSITORY=
DASHBOARD_REPOSITORY=
# Optional fallback when a request doesn't point at any repository.
PHRAX_DEFAULT_REPOSITORY=

# Optional. Where thread workspaces and state live (default ~/.phrax).
# Must be outside this project directory.
PHRAX_DATA_DIR=
# Optional. Extra comma-separated domains sandboxed commands may reach.
PHRAX_ALLOWED_DOMAINS=
